[Unit]
Description=Stable Diffusion ComfyUI ROCm Container
After=network-online.target

[Container]
Image=localhost/sd-rocm:slim
Exec=/conf/startup-comfyui.sh
AutoUpdate=local

ContainerName=comfyui
Network=caddy.network

# For debugging
PodmanArgs=--security-opt=seccomp=unconfined --cap-add=SYS_PTRACE

AddDevice=/dev/kfd:/dev/kfd
AddDevice=/dev/dri:/dev/dri

AddHost=host.docker.internal:host-gateway

# adjust for personal customization
Volume=/data/podman-data/sd-rocm/data/home-comfyui:/root
# Generated images outside the ComfyUI home, so they are easy to browse and back up on their own.
Volume=/data/podman-data/sd-rocm/output:/root/comfyui/output
Volume=/data/podman-data/sd-rocm/data/checkpoints:/checkpoints
Volume=/data/podman-data/sd-rocm/conf:/conf
Environment=DOCKER_INSTANCE=comfyui
Environment=PYTHON_VERSION=3.12
Environment=ROCM_VERSION=nightly
Environment=ROOT_DIR=/root
Environment=COMFYUI_PORT=8080
Environment=DISABLE_PINNED_MEMORY=1
Environment=FAST_DISK=1
Environment=MMAP_TORCH=1
# CACHE_NONE removed 2026-09-02: it forced a cold GGUF reload every job, which under
# VRAM+RAM pressure hit the GGUF partial-load mmap-release loop -> BusyWaitSignal hang.
# Environment=CACHE_NONE=1
# Keep models resident in VRAM between jobs so load_models_gpu always does a full load
# (never lowvram_model_memory>0 -> the mmap-release loop never runs). Needs the fp8
# text encoder so diffusion + TE + VAE fit in 16 GB at once.
Environment=HIGH_VRAM=1
# ComfyUI's dynamic VRAM (default since its Oct 2026 core) ignores --highvram/--lowvram.
# DISABLE_DYNAMIC_VRAM=1 passes --disable-dynamic-vram; it was tried against load hangs in
# Oct 2026 and reverted, so it stays off by default.
# Environment=DISABLE_DYNAMIC_VRAM=1
# Reduce HIP allocator fragmentation that otherwise creeps into the lowvram path.
Environment=PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
HealthCmd=python3 /conf/healthcheck.py
HealthInterval=2m
HealthRetries=5
HealthTimeout=30s
HealthOnFailure=restart

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
