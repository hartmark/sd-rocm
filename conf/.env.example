# Personal overrides for the containers (quadlets or docker-compose).
#
# Copy to conf/.env (all instances) or conf/.env.<DOCKER_INSTANCE>, e.g. conf/.env.comfyui (one instance).
# functions.sh reads them after the quadlet/compose environment, so values set here win. Both files are
# gitignored. Restart the container after a change. Everything below is commented out: the quadlet's
# Environment= lines (or docker-compose) stay the defaults until you set something here.

# --- ROCm / Python ---------------------------------------------------------------------------
# ROCM_VERSION=nightly            # nightly | release | cpuonly
# PYTHON_VERSION=3.12             # must match the venv and the image's standalone CPython

# --- ComfyUI launch flags (1 or true to enable) -----------------------------------------------
# COMFYUI_PORT=8080
# HIGH_VRAM=1                     # --highvram
# LOW_VRAM=1                      # --lowvram
# DISABLE_DYNAMIC_VRAM=1          # --disable-dynamic-vram
# DISABLE_SMART_MEMORY=1          # --disable-smart-memory
# DISABLE_PINNED_MEMORY=1         # --disable-pinned-memory
# MMAP_TORCH=1                    # --mmap-torch-files
# FAST_DISK=1                     # --fast-disk
# CACHE_NONE=1                    # --cache-none (reloads every model each job)
# CACHE_RAM=0                     # --cache-ram <GB>: evict cached models only below this much free RAM (default 0 = never; empty = ComfyUI's 10 % of RAM)

# --- hsa-gentle-wait LD_PRELOAD shim ----------------------------------------------------------
# GENTLE_WAIT=0                   # don't preload the shim at all
# HSA_GENTLE_WAIT=0               # preload it but disable it at runtime

# --- Profiling (see README "Profiling") ------------------------------------------------------
# PROFILING=1
# PROFILING_SAMPLING_INTERVAL=2
# PROFILING_TORCH_PROFILER=1

# --- ROCm / HIP runtime variables are passed through as well, e.g.: ----------------------------
# PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
# GPU_PINNED_MIN_XFER_SIZE=100000

# --- sd-webui (Forge) -------------------------------------------------------------------------
# WEBUI_PORT=7860
